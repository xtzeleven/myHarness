diff --git a/src/main/resources/db/migration/V2__add_orders_total_amount.sql b/src/main/resources/db/migration/V2__add_orders_total_amount.sql
new file mode 100644
index 0000000..d6c8271
--- /dev/null
+++ b/src/main/resources/db/migration/V2__add_orders_total_amount.sql
@@ -0,0 +1,18 @@
+-- V2__add_orders_total_amount.sql
+-- orders 表加 total_amount 列，存订单总金额（Order.totalAmount()：各 OrderItem 的 unitPrice × quantity 之和）。
+--
+-- 字段映射（OrderPO ↔ DB 列，依赖 mybatis-plus map-underscore-to-camel-case=true）：
+--   OrderPO.totalAmount BigDecimal      → total_amount  DECIMAL(19,4)
+--
+-- 设计选择：
+-- 1. 可空、不设 DEFAULT：本迁移之前写入的存量行保持 NULL（表示"当时没记录"），不用 0 冒充真实金额；
+--    发布过程中还没升级、不写该列的旧版本实例也能照常 INSERT。
+--    回填存量行 / 收紧为 NOT NULL 留给后续迁移，本脚本不改任何已有数据。
+-- 2. DECIMAL(19,4) 定点数存金额，不用 FLOAT/DOUBLE；小数超过 4 位的部分入库时四舍五入。
+-- 3. 单笔上限 100000 是 domain 规则（Order.place），不在 DB 层用 CHECK 再表达一遍。
+-- 4. 不建索引：当前没有按金额过滤 / 排序的查询路径。
+--
+-- 回滚：ALTER TABLE orders DROP COLUMN total_amount;（作为新版本迁移提交，不改本文件）
+
+ALTER TABLE orders
+    ADD COLUMN total_amount DECIMAL(19, 4) NULL;
