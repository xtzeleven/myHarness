diff --git a/src/main/resources/db/migration/V2__add_orders_total_amount.sql b/src/main/resources/db/migration/V2__add_orders_total_amount.sql
new file mode 100644
index 0000000..d792d60
--- /dev/null
+++ b/src/main/resources/db/migration/V2__add_orders_total_amount.sql
@@ -0,0 +1,25 @@
+-- V2__add_orders_total_amount.sql
+-- orders 加 total_amount 列，存订单总金额 = Σ(unitPrice × quantity)。
+--
+-- 字段映射：OrderPO.totalAmount  BigDecimal → total_amount  DECIMAL(19,4)
+--
+-- 设计选择：
+-- 1. DECIMAL(19,4)：业务上限 100000（Order.MAX_TOTAL_AMOUNT），整数位绰绰有余；
+--    小数留 4 位，容纳单价出现"厘"级精度的情况。
+-- 2. NOT NULL DEFAULT 0 + 回填：存量行先落 0，再从 items_json 重算，避免出现 NULL 金额。
+--    上限引入前的存量订单即使超过 100000 也照实回填（上限只约束新下单）。
+
+ALTER TABLE orders
+    ADD COLUMN total_amount DECIMAL(19,4) NOT NULL DEFAULT 0;
+
+UPDATE orders o
+SET o.total_amount = (
+    SELECT COALESCE(SUM(j.quantity * j.unit_price), 0)
+    FROM JSON_TABLE(
+        o.items_json, '$[*]'
+        COLUMNS (
+            quantity   INT            PATH '$.quantity',
+            unit_price DECIMAL(19,4)  PATH '$.unitPrice'
+        )
+    ) AS j
+);
