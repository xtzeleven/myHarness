+package com.example.harness.application.order;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.slf4j.LoggerFactory;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.context.ApplicationEventPublisher;
+import org.springframework.context.annotation.Bean;
+import org.springframework.context.annotation.Configuration;
+import org.springframework.context.annotation.Import;
+import org.springframework.test.context.junit.jupiter.SpringJUnitConfig;
+import org.springframework.transaction.PlatformTransactionManager;
+import org.springframework.transaction.TransactionDefinition;
+import org.springframework.transaction.annotation.EnableTransactionManagement;
+import org.springframework.transaction.support.AbstractPlatformTransactionManager;
+import org.springframework.transaction.support.DefaultTransactionStatus;
+import org.springframework.transaction.support.TransactionTemplate;
+
+import com.example.harness.domain.order.OrderId;
+import com.example.harness.domain.order.event.OrderPlaced;
+
+import ch.qos.logback.classic.Level;
+import ch.qos.logback.classic.Logger;
+import ch.qos.logback.classic.spi.ILoggingEvent;
+import ch.qos.logback.core.read.ListAppender;
+
+/**
+ * OrderPlacedNotificationListener 测试。
+ *
+ * 监听器的关键行为是 AFTER_COMMIT，纯 Mockito 测不到事务阶段，所以起一个最小 Spring 上下文
+ * （只含监听器 + 不连库的桩事务管理器），不引 @SpringBootTest。
+ * 提交 → 通知日志 1 条，含客户与订单号；回滚 → 不通知。
+ */
+@SpringJUnitConfig(OrderPlacedNotificationListenerTest.TestConfig.class)
+class OrderPlacedNotificationListenerTest {
+
+    @Configuration
+    @EnableTransactionManagement
+    @Import(OrderPlacedNotificationListener.class)
+    static class TestConfig {
+
+        /** 不连库的桩事务管理器：只驱动事务同步回调（AFTER_COMMIT 靠它触发）。 */
+        @Bean
+        PlatformTransactionManager transactionManager() {
+            return new AbstractPlatformTransactionManager() {
+                @Override
+                protected Object doGetTransaction() {
+                    return new Object();
+                }
+
+                @Override
+                protected void doBegin(Object transaction, TransactionDefinition definition) {}
+
+                @Override
+                protected void doCommit(DefaultTransactionStatus status) {}
+
+                @Override
+                protected void doRollback(DefaultTransactionStatus status) {}
+            };
+        }
+    }
+
+    @Autowired private ApplicationEventPublisher publisher;
+    @Autowired private PlatformTransactionManager transactionManager;
+
+    private final Logger listenerLogger = (Logger) LoggerFactory.getLogger(OrderPlacedNotificationListener.class);
+    private final ListAppender<ILoggingEvent> logs = new ListAppender<>();
+
+    @BeforeEach
+    void attachAppender() {
+        logs.start();
+        listenerLogger.addAppender(logs);
+    }
+
+    @AfterEach
+    void detachAppender() {
+        listenerLogger.detachAppender(logs);
+    }
+
+    @Test
+    void afterCommit_logsNotificationToCustomer() {
+        OrderId orderId = OrderId.generate();
+
+        new TransactionTemplate(transactionManager).executeWithoutResult(
+                status -> publisher.publishEvent(OrderPlaced.of(orderId, "CUST-001")));
+
+        assertThat(logs.list).hasSize(1);
+        ILoggingEvent entry = logs.list.get(0);
+        assertThat(entry.getLevel()).isEqualTo(Level.INFO);
+        assertThat(entry.getFormattedMessage())
+                .contains("CUST-001")
+                .contains(orderId.getValue().toString());
+    }
+
+    /** 事务回滚：订单没落库，不应通知客户。 */
+    @Test
+    void afterRollback_doesNotNotify() {
+        new TransactionTemplate(transactionManager).executeWithoutResult(status -> {
+            publisher.publishEvent(OrderPlaced.of(OrderId.generate(), "CUST-001"));
+            status.setRollbackOnly();
+        });
+
+        assertThat(logs.list).isEmpty();
+    }
+}
