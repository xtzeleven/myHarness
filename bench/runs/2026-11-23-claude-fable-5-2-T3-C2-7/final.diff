diff --git a/src/main/resources/db/migration/V2__add_orders_total_amount.sql b/src/main/resources/db/migration/V2__add_orders_total_amount.sql
new file mode 100644
index 0000000..573f3cd
--- /dev/null
+++ b/src/main/resources/db/migration/V2__add_orders_total_amount.sql
@@ -0,0 +1,16 @@
+-- V2__add_orders_total_amount.sql
+-- orders 加 total_amount：单笔订单总金额（Σ quantity × unitPrice）。
+--
+-- 字段映射（延续 V1 的约定）：
+--   OrderPO.totalAmount BigDecimal      → total_amount  DECIMAL(12,2) NULL
+--
+-- 设计选择：
+-- 1. NULLABLE、不带 DEFAULT：存量行没有记录过总金额，留 NULL 表示"未记录"，不用 0 冒充（0 是合法的总金额）。
+--    新订单由应用在 save 时写入。回填存量 + 收紧 NOT NULL 按"加列 → 回填 → NOT NULL"的安全顺序另出版本。
+-- 2. DECIMAL(12,2)：金额按 2 位小数存，超出 2 位的小数由 MySQL 四舍五入。
+--    上限 100000 的校验在 domain（Order.place），本列不加 CHECK，避免规则两处维护。
+-- 3. 兼容与回滚：旧版本应用不读写本列，可与新 schema 共存；新版本应用依赖本列，须先执行本迁移。
+--    回滚用新版本迁移 DROP COLUMN（本文件入库后不可改）。
+
+ALTER TABLE orders
+    ADD COLUMN total_amount DECIMAL(12, 2) NULL;
