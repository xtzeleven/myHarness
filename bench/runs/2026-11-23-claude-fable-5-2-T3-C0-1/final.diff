+package com.example.harness.domain.order;
+
+import java.math.BigDecimal;
+
+/**
+ * 创建订单时总金额超过 {@link Order#MAX_TOTAL_AMOUNT} 触发的 domain 异常。
+ *
+ * 按 engineering-practices §13 "domain 层抛 domain exception"：
+ * interfaces 层负责翻译为 HTTP 4xx，本类不直接暴露给外部协议。
+ */
+public class OrderAmountExceededException extends RuntimeException {
+
+    public OrderAmountExceededException(BigDecimal totalAmount, BigDecimal limit) {
+        super("订单总金额 " + totalAmount.toPlainString() + " 超过上限 " + limit.toPlainString());
+    }
+}
