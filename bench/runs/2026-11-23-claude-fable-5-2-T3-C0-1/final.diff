diff --git a/src/main/resources/db/migration/V2__add_orders_total_amount.sql b/src/main/resources/db/migration/V2__add_orders_total_amount.sql
new file mode 100644
index 0000000..f8a49ac
--- /dev/null
+++ b/src/main/resources/db/migration/V2__add_orders_total_amount.sql
@@ -0,0 +1,26 @@
+-- V2__add_orders_total_amount.sql
+-- orders 加 total_amount 列，存订单总金额（= Σ quantity × unitPrice，由 Order.totalAmount() 计算）。
+--
+-- 字段映射：
+--   OrderPO.totalAmount  BigDecimal → total_amount  DECIMAL(19,2)
+--
+-- 设计选择：
+-- 1. DECIMAL(19,2) 而非按 100000 上限收窄：上限是 Order.place 的业务规则（可能调整），
+--    且存量订单下单时没有上限，回填值可能超过 100000，列宽不应卡死在当前规则上。
+-- 2. NOT NULL DEFAULT 0：滚动发布期间旧版本实例的 INSERT 不带该列，保留默认值避免写入失败。
+-- 3. 存量行按 items_json 回填，保证加列后历史订单的 total_amount 与明细一致。
+
+ALTER TABLE orders
+    ADD COLUMN total_amount DECIMAL(19, 2) NOT NULL DEFAULT 0;
+
+UPDATE orders o
+SET o.total_amount = (
+    SELECT COALESCE(SUM(jt.quantity * jt.unit_price), 0)
+    FROM JSON_TABLE(
+        o.items_json, '$[*]'
+        COLUMNS (
+            quantity   INT             PATH '$.quantity',
+            unit_price DECIMAL(19, 4)  PATH '$.unitPrice'
+        )
+    ) AS jt
+);
