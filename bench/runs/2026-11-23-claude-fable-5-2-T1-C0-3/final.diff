+package com.example.harness.domain.order;
+
+/**
+ * 对非 PENDING 状态的订单执行取消时触发的 domain 异常。
+ *
+ * 按 engineering-practices §13 "domain 层抛 domain exception"：
+ * interfaces 层负责翻译为 HTTP 4xx，本类不直接暴露给外部协议。
+ */
+public class OrderNotCancellableException extends RuntimeException {
+
+    public OrderNotCancellableException(OrderId id, OrderStatus status) {
+        super("订单 " + id.getValue() + " 当前状态为 " + status + "，仅 PENDING 状态可取消");
+    }
+}
