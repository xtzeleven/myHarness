+package com.example.harness.application.order;
+
+import com.example.harness.domain.order.OrderId;
+
+/**
+ * 用例按 ID 找不到订单时抛出。
+ *
+ * 放在 application 层而非 domain：「查不到」是用例编排的加载失败，不是聚合内的业务规则违例
+ * （ArchUnit 规则亦禁止 application 自己构造 domain 异常）。interfaces 层翻译为 HTTP 404。
+ */
+public class OrderNotFoundException extends RuntimeException {
+
+    public OrderNotFoundException(OrderId id) {
+        super("订单 " + id.getValue() + " 不存在");
+    }
+}
