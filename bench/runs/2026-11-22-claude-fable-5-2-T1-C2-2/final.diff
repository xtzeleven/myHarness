+package com.example.harness.application.order;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.Mockito.never;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+
+import java.math.BigDecimal;
+import java.util.List;
+import java.util.Optional;
+
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+
+import com.example.harness.domain.order.Order;
+import com.example.harness.domain.order.OrderId;
+import com.example.harness.domain.order.OrderItem;
+import com.example.harness.domain.order.OrderNotCancellableException;
+import com.example.harness.domain.order.OrderNotFoundException;
+import com.example.harness.domain.order.OrderStatus;
+import com.example.harness.domain.order.repository.OrderRepository;
+
+/**
+ * CancelOrderHandler 单测。
+ *
+ * 用 Mockito mock OrderRepository；`getById` 走接口的真实 default 实现（基于被 stub 的 `findById`），
+ * 这样"订单不存在"路径验证的是 domain 抛出的异常，而不是测试自己 stub 的异常。
+ * 正常路径 → 订单变 CANCELLED 并 repo.save 1 次
+ * 失败路径 → domain 异常直接冒泡，repo.save **不**被调
+ */
+class CancelOrderHandlerTest {
+
+    private OrderRepository repository;
+    private CancelOrderHandler handler;
+
+    @BeforeEach
+    void setUp() {
+        repository = org.mockito.Mockito.mock(OrderRepository.class);
+        when(repository.getById(any())).thenCallRealMethod();
+        handler = new CancelOrderHandler(repository);
+    }
+
+    private static Order orderIn(OrderStatus status) {
+        return Order.reconstitute(
+                OrderId.generate(),
+                "CUST-001",
+                List.of(new OrderItem("SKU-1", 1, new BigDecimal("1.00"))),
+                status);
+    }
+
+    @Test
+    void handle_cancelsPendingOrderAndSaves() {
+        Order order = orderIn(OrderStatus.PENDING);
+        when(repository.findById(order.id())).thenReturn(Optional.of(order));
+
+        handler.handle(new CancelOrderCommand(order.id()));
+
+        assertThat(order.status()).isEqualTo(OrderStatus.CANCELLED);
+        verify(repository).save(order);
+    }
+
+    /** 非 PENDING：domain 层抛 OrderNotCancellableException，application 不 catch；不落库。 */
+    @Test
+    void handle_nonPendingOrder_propagatesOrderNotCancellableException() {
+        Order order = orderIn(OrderStatus.CONFIRMED);
+        when(repository.findById(order.id())).thenReturn(Optional.of(order));
+
+        assertThatThrownBy(() -> handler.handle(new CancelOrderCommand(order.id())))
+                .isInstanceOf(OrderNotCancellableException.class);
+
+        assertThat(order.status()).isEqualTo(OrderStatus.CONFIRMED);
+        verify(repository, never()).save(any());
+    }
+
+    @Test
+    void handle_unknownOrder_propagatesOrderNotFoundException() {
+        OrderId unknown = OrderId.generate();
+        when(repository.findById(unknown)).thenReturn(Optional.empty());
+
+        assertThatThrownBy(() -> handler.handle(new CancelOrderCommand(unknown)))
+                .isInstanceOf(OrderNotFoundException.class);
+
+        verify(repository, never()).save(any());
+    }
+}
