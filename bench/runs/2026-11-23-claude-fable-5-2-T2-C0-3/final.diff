+package com.example.harness.application.order;
+
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.stereotype.Component;
+import org.springframework.transaction.event.TransactionalEventListener;
+
+import com.example.harness.domain.order.event.OrderPlaced;
+
+/**
+ * OrderPlaced 事件消费者：下单成功后给客户发通知。
+ *
+ * 当前用日志模拟发送；接入真实通道（短信 / 邮件 / 站内信）时替换 `on` 的方法体即可。
+ *
+ * 用 `@TransactionalEventListener`（默认 AFTER_COMMIT）而非 `@EventListener`：
+ * - `PlaceOrderHandler.handle` 在事务内发事件，订单提交成功后才通知；回滚则不通知
+ * - 通知在提交之后执行，发送失败不会回滚已落库的订单
+ */
+@Component
+public class OrderPlacedNotificationListener {
+
+    private static final Logger log = LoggerFactory.getLogger(OrderPlacedNotificationListener.class);
+
+    @TransactionalEventListener
+    public void on(OrderPlaced event) {
+        log.info("[模拟通知] 订单已下单，通知客户：customerId={}, orderId={}",
+                event.customerId(), event.orderId().getValue());
+    }
+}
